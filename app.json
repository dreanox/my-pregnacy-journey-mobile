{
  "expo": {
    "name": "My Pregnancy Journey",
    "slug": "my-pregnancy-journey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mypregnancyjourney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypregnancyjourney.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take belly photos",
        "NSPhotoLibraryUsageDescription": "We need photo library access to save and pick belly photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF0F5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mypregnancyjourney.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Pregnancy Journey to access your photos to track your belly evolution.",
          "cameraPermission": "Allow My Pregnancy Journey to use the camera to capture belly photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
