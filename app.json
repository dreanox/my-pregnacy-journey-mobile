{
  "expo": {
    "name": "MIDE",
    "slug": "mide",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-solid.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFF0F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mide.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "MIDE needs camera access to capture belly photos.",
        "NSPhotoLibraryUsageDescription": "MIDE needs photo library access to save and pick belly photos.",
        "NSLocationWhenInUseUsageDescription": "MIDE may use your location while the app is open when required by notifications or other integrated services. Your pregnancy data in MIDE does not rely on your location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF0F5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mide.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MIDE to access your photos to track your belly evolution.",
          "cameraPermission": "Allow MIDE to use the camera to capture belly photos."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5ae3bf58-2395-402c-b562-67176bf0979d"
      },
      "router": {}
    },
    "owner": "drakgengard"
  }
}
